# Copy to .env.local for local work. Never commit real values.
# Set the same names in Vercel: Project Settings > Environment Variables (Production and Preview).

# Service account email, e.g. crew-form@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON file. Keep the \n sequences as written.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_KEY\n-----END PRIVATE KEY-----\n"
# The ID in the Sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Optional. Tab name for the responses. Defaults to "Responses".
GOOGLE_SHEET_TAB=Responses
